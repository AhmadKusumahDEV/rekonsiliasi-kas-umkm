# Aplikasi native di VPS yang sama dengan Collector pusat.
# Jangan memakai "localhost"; Collector dipublikasikan di IPv4 loopback.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Nama stabil service. Environment dan versi bukan bagian dari nama ini.
OTEL_SERVICE_NAME=rekonsiliasi-kas-api

# Pisahkan atribut dengan koma tanpa spasi.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=efaudit,service.version=dev

# 1 menyimpan semua trace. Turunkan untuk trafik produksi yang besar.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1

# Interval pengiriman metrics dalam milidetik.
OTEL_METRIC_EXPORT_INTERVAL=10000

# gzip mengurangi bandwidth payload OTLP.
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Level log aplikasi: debug, info, warn, atau error.
OBSERVABILITY_LOG_LEVEL=info

# Heartbeat untuk alert service down. Jangan lebih dari 15 detik.
OBSERVABILITY_HEARTBEAT_INTERVAL=15

# Jika aplikasi berada di VPS lain, ganti tiga nilai di atas dengan:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.madgo.my.id
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64_URLENCODED
# dan tambahkan OTEL_EXPORTER_OTLP_TIMEOUT=10000.
