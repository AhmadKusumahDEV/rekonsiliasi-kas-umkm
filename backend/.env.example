# Salin nilai yang dibutuhkan ke environment. File ini tidak dibaca otomatis.
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Produksi: pisahkan dengan koma, tanpa trailing slash.
# CORS_ALLOWED_ORIGINS=https://temukas.madgo.my.id,https://efa.madgo.my.id

# Database boleh dinonaktifkan selama scaffold belum memakai endpoint domain.
DATABASE_ENABLED=false
DATABASE_URL=
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=rekonsiliasi_kas_umkm
# DATABASE_SSLMODE=disable
