app:
  name: rekonsiliasi-kas-umkm
  environment: development

server:
  host: 0.0.0.0
  port: 8080
  read_timeout: 10s
  write_timeout: 15s
  idle_timeout: 60s
  shutdown_timeout: 10s
  allowed_origins:
    - http://localhost:3000
    - http://localhost:5173

database:
  # Aktifkan setelah PostgreSQL tersedia. Isi url untuk memakai DSN utuh, atau
  # kosongkan url dan pakai field host/username/password/name di bawah.
  enabled: false
  url: ""
  host: localhost
  port: 5432
  username: postgres
  password: postgres
  name: rekonsiliasi_kas_umkm
  sslmode: disable
  max_conns: 10
  min_conns: 0
  max_conn_lifetime: 30m
  max_conn_idle_time: 5m
  health_check_period: 30s
  connect_timeout: 10s
